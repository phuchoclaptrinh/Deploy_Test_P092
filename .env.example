# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your own values.
# NEVER commit .env, and never put a real credential in this file: it is
# tracked, so anything written here is published to everyone with repository
# access and has to be treated as burned.

# ---- LLM Configuration ----
OPENAI_API_KEY=your-openai-api-key
MODEL_NAME=gpt-4o-mini
LLM_TEMPERATURE=0.2
# OpenAI GPT-5.1+ models are called with reasoning_effort=none. This is fixed
# intentionally for the ticket-classification latency path; gpt-4o-mini has no
# reasoning mode and receives no unsupported parameter.
LLM_REASONING_EFFORT=none

# Anthropic is the fallback provider for the analysis agent. Both variables must
# be set to enable it; leave either blank and the agent runs on OpenAI alone.
ANTHROPIC_API_KEY=<your-anthropic-api-key>
ANTHROPIC_FALLBACK_MODEL=claude-sonnet-4-6

# ---- Database ----
# Must be your own Supabase project's Postgres connection string: the migrations
# reference Supabase's auth.users table, so a plain local Postgres will not
# migrate without the compatibility shim described in docs/v4_operations.md.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
# For SQLite (development only; migrations are written for PostgreSQL):
# DATABASE_URL=sqlite:///./data/app.db

# ---- Supabase ----
# Dashboard -> Project Settings -> Data API (URL + publishable key) and
# Project Settings -> API Keys (secret / service_role key).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SECRET_KEY=your-supabase-secret-key
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_VERIFICATION_MODE=auto
SUPABASE_STORAGE_BUCKET=ticket-attachments
SUPABASE_SIGNED_DOWNLOAD_TTL_SECONDS=300
MAX_TICKET_IMAGE_BYTES=10485760
ALLOWED_TICKET_IMAGE_MIME_TYPES=image/jpeg,image/png,image/webp

# ---- Resident OTP mock (development only) ----
# Supabase sends Resident OTP through Twilio SMS. Enable this to sign in as a
# seeded Resident phone with DEV_OTP_MOCK_CODE instead. Startup fails if this is
# left on with APP_ENV=production.
DEV_OTP_MOCK_ENABLED=true
DEV_OTP_MOCK_CODE=000000

# ---- Development sign-in shortcuts (never enable in production) ----
ENABLE_DEV_PASSWORD_LOGIN=true
DEV_RESIDENT_PHONE=+84900000000
DEV_RESIDENT_UNIT_CODE=A-1203
DEV_RESIDENT_EMAIL=resident.test@example.local
DEV_RESIDENT_PASSWORD=<local-dev-password>
DEV_COORDINATOR_EMAIL=coordinator.test@example.local
DEV_COORDINATOR_PASSWORD=<local-dev-password>
DEV_TECHNICIAN_EMAIL=technician.test@example.local
DEV_TECHNICIAN_PASSWORD=<local-dev-password>

# ---- App Config ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
LOG_LEVEL=INFO
ALLOW_LIVE_MIGRATION=true
RUN_SUPABASE_INTEGRATION_TESTS=false
ENABLE_LEGACY_AGENT_ROUTES=false

# ---- Agent contract rollout (contract v4 §18.2) ----
# Which contract a NEW ticket starts on. Sessions already in flight are
# unaffected: they resume on the contract stored in
# ai_analysis_sessions.model_version.
ANALYSIS_CONTRACT_VERSION=v4

# ---- Assignment decision engine (contract v4 §4.0) ----
# RULE  -> RULE_ENGINE_V1, the deterministic ranking in src/assignment_rules.
#          No model call, no 300-second window, and no MANUAL_REQUIRED caused
#          by a model timing out. Tuned in config/assignment_rules.yaml.
# AI    -> the original contract §4-§5 model path. Kept as a rollback for the
#          case where the ranking allocates work in a way the building manager
#          disagrees with; the two model variables below are read only then.
ASSIGNMENT_DECISION_ENGINE=RULE

# Any rule in config/assignment_rules.yaml can be overridden per environment.
# Unset here so the file stays the single source of truth.
# ASSIGNMENT_RULE_MAX_ACTIVE_ASSIGNMENTS=5
# ASSIGNMENT_RULE_MAX_ACTIVE_P3_ASSIGNMENTS=2
# ASSIGNMENT_RULE_ALLOW_P3_OVERLOAD_WHEN_ALL_CAPPED=true
# ASSIGNMENT_RULES_FILE=/etc/fixit/assignment_rules.yaml

# ---- Assignment Agent, ASSIGNMENT_DECISION_ENGINE=AI only (contract v4 §5.2) ----
# The fallback must be a genuinely different model; pointing it at the primary
# gives a failover that fails in exactly the same way, and startup validation
# rejects it while the AI engine is selected.
ASSIGNMENT_PRIMARY_MODEL=gpt-4o-mini
ASSIGNMENT_FALLBACK_MODEL=claude-sonnet-4-6
ASSIGNMENT_MODEL_TIMEOUT_SECONDS=300
ASSIGNMENT_MODEL_TEMPERATURE=0.0
ASSIGNMENT_GRACE_SECONDS=300
ASSIGNMENT_REASSIGNMENT_CAP=3
DIRECT_REQUEST_MAX_TICKET_COUNT=20
PROPOSAL_TTL_SECONDS=600
INCIDENT_CASE_MAX_TICKET_COUNT=5
INCIDENT_CASE_SLA_EXTENSION_PER_EXTRA_TICKET=0.25
ACCEPTANCE_WARNING_P1_SECONDS=172800
ACCEPTANCE_REASSIGN_P1_SECONDS=176400
ACCEPTANCE_WARNING_P2_SECONDS=7200
ACCEPTANCE_REASSIGN_P2_SECONDS=9000
ACCEPTANCE_REASSIGN_P3_SECONDS=300

# ---- Assignment worker (python -m src.workers.assignment_worker) ----
ASSIGNMENT_WORKER_POLL_SECONDS=15
ASSIGNMENT_WORKER_BATCH_SIZE=20
ASSIGNMENT_JOB_CLAIM_TIMEOUT_SECONDS=900

# ---- Agent tracing ----
AGENT_TRACE_ENABLED=true
AGENT_TRACE_DIR=.ai-log/agent
AGENT_TRACE_TEXT_LIMIT=500

# ---- LangSmith (AI Logs — Deliverable #4) ----
LANGCHAIN_API_KEY=<your-langsmith-api-key>
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=true

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=your-ai-log-api-key
AI_LOG_DIR=.ai-log

# ---- Frontend (if separate) ----
# NEXT_PUBLIC_API_URL=http://localhost:8000
