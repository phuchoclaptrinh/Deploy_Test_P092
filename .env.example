# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your own values.
# NEVER commit .env, and never put a real credential in this file: it is
# tracked, so anything written here is published to everyone with repository
# access and has to be treated as burned.

# ---- LLM Configuration ----
OPENAI_API_KEY=<your-openai-api-key>
MODEL_NAME=gpt-4o-mini
LLM_TEMPERATURE=0.2
# OpenAI GPT-5.1+ models are called with reasoning_effort=none. This is fixed
# intentionally for the ticket-classification latency path; gpt-4o-mini has no
# reasoning mode and receives no unsupported parameter.
LLM_REASONING_EFFORT=none

# Anthropic is the fallback provider for the analysis agent. Both variables must
# be set to enable it; leave either blank and the agent runs on OpenAI alone.
ANTHROPIC_API_KEY=<your-anthropic-api-key>
ANTHROPIC_FALLBACK_MODEL=claude-sonnet-4-6

# ---- Database ----
# Must be your own Supabase project's Postgres connection string: the migrations
# reference Supabase's auth.users table, so a plain local Postgres will not
# migrate without the compatibility shim described in docs/v4_operations.md.
DATABASE_URL=postgresql://user:password@db.example.supabase.co:5432/postgres
# For SQLite (development only; migrations are written for PostgreSQL):
# DATABASE_URL=sqlite:///./data/app.db

# ---- Supabase ----
# Dashboard -> Project Settings -> Data API (URL + publishable key) and
# Project Settings -> API Keys (secret / service_role key).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=<your-supabase-publishable-key>
SUPABASE_SECRET_KEY=<your-supabase-secret-key>
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_VERIFICATION_MODE=auto
SUPABASE_STORAGE_BUCKET=ticket-attachments
SUPABASE_SIGNED_DOWNLOAD_TTL_SECONDS=300
MAX_TICKET_IMAGE_BYTES=10485760
ALLOWED_TICKET_IMAGE_MIME_TYPES=image/jpeg,image/png,image/webp

# ---- Resident OTP mock (development only) ----
# Supabase sends Resident OTP through Twilio SMS. Enable this to sign in as a
# seeded Resident phone with DEV_OTP_MOCK_CODE instead. Startup fails if this is
# left on with APP_ENV=production.
DEV_OTP_MOCK_ENABLED=true
DEV_OTP_MOCK_CODE=000000

# ---- Development sign-in shortcuts (never enable in production) ----
ENABLE_DEV_PASSWORD_LOGIN=true
DEV_RESIDENT_PHONE=+84900000000
DEV_RESIDENT_UNIT_CODE=A-1203
DEV_RESIDENT_EMAIL=resident.test@example.local
DEV_RESIDENT_PASSWORD=<local-dev-password>
DEV_COORDINATOR_EMAIL=coordinator.test@example.local
DEV_COORDINATOR_PASSWORD=<local-dev-password>
DEV_TECHNICIAN_EMAIL=technician.test@example.local
DEV_TECHNICIAN_PASSWORD=<local-dev-password>

# ---- App Config ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
LOG_LEVEL=INFO
# Leave this off. `alembic upgrade` refuses to run without it, which is the
# point: the chain runs through a1b2c3d4e5f7, which deletes the ticket graph
# and has no downgrade. Set it on the one command that migrates:
#
#     ALLOW_LIVE_MIGRATION=true python -m alembic upgrade head
#
# A non-local DATABASE_URL additionally needs MIGRATION_TARGET set to that
# database's host[:port]/name. Read-only commands such as `alembic current` do
# not need either flag. See docs/operations.md 12.
ALLOW_LIVE_MIGRATION=false
RUN_SUPABASE_INTEGRATION_TESTS=false
ENABLE_LEGACY_AGENT_ROUTES=false

# ---- Agent contract rollout (contract v4 §18.2) ----
# Which contract a NEW ticket starts on. Sessions already in flight are
# unaffected: they resume on the contract stored in
# ai_analysis_sessions.model_version.
ANALYSIS_CONTRACT_VERSION=v4

# ---- Dispatch and scheduling (§4-§8) ----------------------------------------
# The ACCEPTANCE_DUE_* windows are gone along with the acceptance step, and
# nothing has replaced them: `start_due_at` and its grace period are an open
# business decision. See `src.services.operational_timeout_service`.
#
# They are deleted rather than left commented out because the comment had gone
# stale in a way that mattered -- it said P3 was the emergency band, which was
# true under the v1 rubric and is not true now that P5 is.

# The scheduler's safety buffer, in seconds (§6). Thirty minutes: shorter than
# the shortest P80 duration so it never dominates, long enough to absorb travel
# between two jobs in the same building.
# DISPATCH_SAFETY_BUFFER_SECONDS=1800

# Micro-batch shape (§8). The 20-ticket ceiling is the contract's, not a tuning
# knob -- the settings model refuses anything higher.
# DISPATCH_MICRO_BATCH_SIZE=20
# DISPATCH_MICRO_BATCH_INTERVAL_MS=750
# DISPATCH_CLAIM_TIMEOUT_SECONDS=120
# DISPATCH_MAX_ATTEMPTS=3

# The at-risk agent (§7). Called once per micro-batch, for the AT_RISK subset
# only. A timeout or failure is not fatal: the dispatcher falls back to the
# scheduler's least-negative-slack candidate, records the decision as
# SCHEDULER_FALLBACK and tells Building Management.
# AT_RISK_AGENT_ENABLED=true
# AT_RISK_AGENT_MODEL=            # falls back to MODEL_NAME when blank
# AT_RISK_AGENT_TIMEOUT_SECONDS=20
# AT_RISK_AGENT_MAX_CONCURRENCY=2
# AT_RISK_AGENT_HISTORY_WINDOWS_DAYS=30,60,90

# ---- Database session budget (§8) -------------------------------------------
# The Supabase session pooler has a hard quota, and the API and the dispatch
# worker are two processes sharing it. Neither can see the other's usage, so the
# sum is checked at startup: a configuration whose worst case exceeds
# SUPABASE_MAX_SESSIONS refuses to boot rather than failing at peak load.
# SUPABASE_MAX_SESSIONS=15
# API_DB_POOL_SIZE=5
# API_DB_MAX_OVERFLOW=2
# DISPATCH_WORKER_DB_POOL_SIZE=2
# DISPATCH_WORKER_DB_MAX_OVERFLOW=1

# ---- Dispatch worker (python -m src.workers.dispatch_worker) ----
# The micro-batch interval, in seconds. §8 asks for roughly 0.5-1s; the value
# above (DISPATCH_MICRO_BATCH_INTERVAL_MS) is what the loop actually uses, and
# this only bounds how long a stopped worker waits before exiting.
DISPATCH_WORKER_POLL_SECONDS=1.0

# ---- Agent tracing ----
AGENT_TRACE_ENABLED=true
AGENT_TRACE_DIR=.ai-log/agent
AGENT_TRACE_TEXT_LIMIT=500

# ---- LangSmith (AI Logs — Deliverable #4) ----
LANGCHAIN_API_KEY=<your-langsmith-api-key>
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=true

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=<key-issued-to-your-team>
AI_LOG_DIR=.ai-log

# ---- Frontend (if separate) ----
# NEXT_PUBLIC_API_URL=http://localhost:8000
