# Production environment template. Do not commit live credentials.
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
PORT=8000
LOG_LEVEL=INFO
ALLOW_LIVE_MIGRATION=false
ENABLE_DEV_PASSWORD_LOGIN=false
DEV_OTP_MOCK_ENABLED=false
ENABLE_LEGACY_AGENT_ROUTES=false
CORS_ORIGINS=https://your-frontend.example.com

# Frontend configuration
NEXT_PUBLIC_API_URL=https://your-api.example.com
NEXT_PUBLIC_API_BASE_URL=https://your-api.example.com/api/v1
NEXT_PUBLIC_AUTH_DISABLED=false
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
NEXT_PUBLIC_DEV_PASSWORD_LOGIN=false
NEXT_PUBLIC_DEV_AUTH_ENABLED=false

# Backend integrations
DATABASE_URL=postgresql+psycopg://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_VERIFICATION_MODE=remote
SUPABASE_STORAGE_BUCKET=tickets
SUPABASE_SIGNED_DOWNLOAD_TTL_SECONDS=3600
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
MODEL_NAME=gpt-4.1-mini
LLM_TEMPERATURE=0
# Current runtime only accepts "none" for this setting.
LLM_REASONING_EFFORT=none
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY
ANTHROPIC_FALLBACK_MODEL=claude-3-5-haiku-latest
ANALYSIS_CONTRACT_VERSION=v4

# Assignment and incident-case workflow
ASSIGNMENT_GRACE_SECONDS=300
ASSIGNMENT_REASSIGNMENT_CAP=3
DIRECT_REQUEST_MAX_TICKET_COUNT=10
PROPOSAL_TTL_SECONDS=1800
INCIDENT_CASE_MAX_TICKET_COUNT=20
INCIDENT_CASE_SLA_EXTENSION_PER_EXTRA_TICKET=300
ACCEPTANCE_WARNING_P1_SECONDS=300
ACCEPTANCE_REASSIGN_P1_SECONDS=600
ACCEPTANCE_WARNING_P2_SECONDS=900
ACCEPTANCE_REASSIGN_P2_SECONDS=1800
ACCEPTANCE_REASSIGN_P3_SECONDS=3600
DISPATCH_CLAIM_TIMEOUT_SECONDS=120
DISPATCH_MICRO_BATCH_INTERVAL_MS=750
DISPATCH_MICRO_BATCH_SIZE=20
# §8: the API and the worker share the Supabase session quota, and the sum is
# checked at startup rather than at peak load.
SUPABASE_MAX_SESSIONS=15
API_DB_POOL_SIZE=5
API_DB_MAX_OVERFLOW=2
DISPATCH_WORKER_DB_POOL_SIZE=2
DISPATCH_WORKER_DB_MAX_OVERFLOW=1
ASSIGNMENT_PRIMARY_MODEL=gpt-4.1-mini
ASSIGNMENT_FALLBACK_MODEL=gpt-4.1-mini
ASSIGNMENT_MODEL_TIMEOUT_SECONDS=30
ASSIGNMENT_MODEL_TEMPERATURE=0

# Optional observability
AGENT_TRACE_ENABLED=false
AGENT_TRACE_DIR=var/agent-traces
AGENT_TRACE_TEXT_LIMIT=4000
BRAINTRUST_API_KEY=YOUR_BRAINTRUST_API_KEY
MAX_TICKET_IMAGE_BYTES=10485760
ALLOWED_TICKET_IMAGE_MIME_TYPES=image/jpeg,image/png,image/webp
